---
import '../styles/global.css';
---

<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Avellon Executive | Web Solutions</title>
</head>
<body class="bg-black text-gray-200 font-sans antialiased selection:bg-yellow-500 selection:text-black">
    <main class="min-h-screen flex flex-col justify-center items-center px-6 text-center">
        <div class="max-w-3xl mx-auto">
            <h1 class="text-5xl md:text-7xl font-extrabold tracking-tight text-white mb-6">
                AVELLON<span class="text-yellow-600">.</span>
            </h1>
            <p class="text-xl md:text-2xl font-light text-gray-400 mb-10 leading-relaxed">
                Digital Asset Ready in 48 Hours.<br class="hidden md:block"/> No pointless Zoom calls. Pure asynchronous execution.
            </p>
            <a href="#" class="inline-block bg-yellow-600 hover:bg-yellow-500 text-black font-semibold text-lg px-8 py-4 rounded-sm transition-all duration-300">
                Initiate Deployment
            </a>
            <div class="mt-16 text-sm text-gray-600 tracking-widest uppercase">
                <p>Enterprise Grade • Zero Meetings • $0 Maintenance</p>
            </div>
        </div>
    </main>
</body>
</html>